{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ora IDE",
  "version": "0.1.0",
  "identifier": "dev.oraide.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ora IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ora IDE",
    "category": "DeveloperTool",
    "shortDescription": "Oracle SQL IDE",
    "longDescription": "A fast, lightweight Oracle SQL IDE with explain plans, a schema knowledge base, a local sandbox and AI assistance.",
    "copyright": "MIT licensed",
    "windows": {
      "wix": {
        "upgradeCode": "6f1f7a52-3c0e-4f4b-9a49-8f6b2b0d3a17",
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
